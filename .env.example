HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=resend
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM=no-reply@yourdomain.com
SMTP_REPLY_TO=support@yourdomain.com

# === Purchase verify (production) ===
# false => gerçek provider doğrulaması zorunlu
# true  => sağlayıcı doğrulama kapalı, soft pass (sadece local/dev)
PURCHASE_VERIFY_SOFT=false

# Google Play verify
GOOGLE_PLAY_PACKAGE_NAME=com.example.tarim360
GOOGLE_SERVICE_ACCOUNT_EMAIL=play-billing@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Apple App Store verifyReceipt (auto-renewable subscriptions için shared secret)
APPLE_SHARED_SECRET=replace_with_apple_shared_secret

# Webhook security
PURCHASE_WEBHOOK_SECRET=replace_with_long_random_secret
# İstersen provider bazlı ayrı secret kullan
GOOGLE_PLAY_WEBHOOK_SECRET=
APPLE_WEBHOOK_SECRET=

# Sadece local test için secretsiz webhook kabulü
PURCHASE_WEBHOOK_ALLOW_NO_SECRET=false

# One-shot data cleanup flags (set true only for a single deploy, then set back to false)
CLEANUP_MALFORMED_TEST_DATA=false
CLEANUP_LEGACY_SUPPORT_MESSAGES=false

# Agricultural data ingestion (disabled by default; mock source only)
AGRI_INGESTION_ENABLED=false
AGRI_INGESTION_CRON="0 */6 * * *"

# Province weather cache (disabled by default)
AGRI_WEATHER_INGESTION_ENABLED=false
AGRI_WEATHER_INGESTION_CRON="15 */3 * * *"
# Leave empty until the correct Open-Meteo licence/plan is selected.
OPEN_METEO_BASE_URL=
OPEN_METEO_API_KEY=

# Firebase Cloud Messaging (legacy HTTP server key)
# Firebase Console -> Project settings -> Cloud Messaging -> Server key
FCM_SERVER_KEY=
