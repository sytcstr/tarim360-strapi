    "currentCity": { "type": "string", "required": true },
    "latitude": { "type": "decimal", "required": true },
    "longitude": { "type": "decimal", "required": true },
    "available": { "type": "boolean", "default": true },
    "phone": { "type": "string" },
    "whatsapp": { "type": "string" },
    "rating": { "type": "decimal", "default": 4.5 },
