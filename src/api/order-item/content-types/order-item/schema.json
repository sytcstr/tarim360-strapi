{
  "kind": "collectionType",
  "collectionName": "order_items",
  "info": {
    "singularName": "order-item",
    "pluralName": "order-items",
    "displayName": "Order Item"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "order": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::order.order",
      "inversedBy": "items",
      "required": true
    },
    "productLocalId": {
      "type": "string",
      "required": true
    },
    "sellerId": {
      "type": "string",
      "required": true
    },
    "quantity": {
      "type": "integer",
      "required": true,
      "min": 1,
      "default": 1
    },
    "price": {
      "type": "decimal",
      "required": true,
      "default": 0
    },
    "total": {
      "type": "decimal",
      "required": true,
      "default": 0
    }
  }
}
