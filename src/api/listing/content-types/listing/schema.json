{
  "kind": "collectionType",
  "collectionName": "listings",
  "info": {
    "singularName": "listing",
    "pluralName": "listings",
    "displayName": "Listing"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "mode": {
      "type": "enumeration",
      "enum": [
        "sell",
        "buy"
      ]
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "active",
        "rejected"
      ],
      "default": "active"
    },
    "mainType": {
      "type": "string"
    },
    "subType": {
      "type": "string"
    },
    "price": {
      "type": "decimal"
    },
    "priceUnit": {
      "type": "string"
    },
    "demandAmount": {
      "type": "decimal"
    },
    "maxBudget": {
      "type": "decimal"
    },
    "hasatYear": {
      "type": "integer"
    },
    "hasatDate": {
      "type": "string"
    },
    "qualityGrade": {
      "type": "string"
    },
    "moisture": {
      "type": "decimal"
    },
    "protein": {
      "type": "decimal"
    },
    "certificateType": {
      "type": "string"
    },
    "analysisNote": {
      "type": "text"
    },
    "packaging": {
      "type": "string"
    },
    "storage": {
      "type": "string"
    },
    "delivery": {
      "type": "string"
    },
    "minOrder": {
      "type": "decimal"
    },
    "minOrderUnit": {
      "type": "string"
    },
    "animalAge": {
      "type": "string"
    },
    "animalWeight": {
      "type": "string"
    },
    "equipCondition": {
      "type": "string"
    },
    "equipWorkHour": {
      "type": "string"
    },
    "equipModelYear": {
      "type": "integer"
    },
    "location": {
      "type": "json"
    },
    "city": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "cityNormalized": {
      "type": "string"
    },
    "searchNormalized": {
      "type": "text"
    },
    "ownerProfileId": {
      "type": "string"
    },
    "ownerId": {
      "type": "string"
    },
    "ownerName": {
      "type": "string"
    },
    "ownerCity": {
      "type": "string"
    },
    "ownerEmail": {
      "type": "email",
      "private": true
    },
    "isPremiumOwner": {
      "type": "boolean"
    },
    "isPremium": {
      "type": "boolean"
    },
    "isDoping": {
      "type": "boolean"
    },
    "rocketEndsAt": {
      "type": "datetime"
    },
    "listingNo": {
      "type": "integer"
    },
    "viewCount": {
      "type": "integer",
      "default": 0
    },
    "favoriteCount": {
      "type": "integer",
      "default": 0
    },
    "likeCount": {
      "type": "integer",
      "default": 0
    },
    "offerCount": {
      "type": "integer",
      "default": 0
    },
    "commentCount": {
      "type": "integer",
      "default": 0
    },
    "shareCount": {
      "type": "integer",
      "default": 0
    },
    "engagementVersion": {
      "type": "integer",
      "default": 0
    },
    "createdAtClient": {
      "type": "datetime"
    },
    "photos": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
