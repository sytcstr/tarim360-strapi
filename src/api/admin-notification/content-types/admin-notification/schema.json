{
  "kind": "collectionType",
  "collectionName": "admin_notifications",
  "info": {
    "singularName": "admin-notification",
    "pluralName": "admin-notifications",
    "displayName": "Admin Notification"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "message": {
      "type": "text",
      "required": true
    },
    "audience": {
      "type": "enumeration",
      "enum": [
        "single",
        "all"
      ],
      "default": "single",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "campaign",
        "announcement",
        "system"
      ],
      "default": "announcement"
    },
    "targetUser": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "deliveryStatus": {
      "type": "enumeration",
      "enum": [
        "queued",
        "sent",
        "failed"
      ],
      "default": "queued"
    },
    "sentAt": {
      "type": "datetime"
    },
    "sentCount": {
      "type": "integer",
      "default": 0
    },
    "lastError": {
      "type": "text"
    }
  }
}
